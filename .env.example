# Copy to .env and fill in. .env is gitignored.

# Common
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
REQUEST_TIMEOUT_SECONDS=30
DEFAULT_RATE_LIMIT_PER_SECOND=1.5

# Per-platform overrides (optional). Fallback to DEFAULT_* if blank.
TIKI_RATE_LIMIT_PER_SECOND=
SHOPEE_RATE_LIMIT_PER_SECOND=
LAZADA_RATE_LIMIT_PER_SECOND=
SENDO_RATE_LIMIT_PER_SECOND=

# Browser
HEADLESS=true

# Output
OUTPUT_DIR=outputs
RUN_ID=
